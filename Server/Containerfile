# TiledFlipper のローカルテストサーバーを Apple Container (`container` CLI) や
# 一般的な OCI ランタイムでビルド・実行するための Containerfile。
#
# マルチステージビルド: `swift:${SWIFT_VERSION}` でビルドし、
# `swift:${SWIFT_VERSION}-slim` へ成果物だけコピーして実行する。将来
# Google Cloud Run / AWS App Runner 等へそのままデプロイする場合も
# 同じイメージを使い回せる。
#
# 既定は Google Cloud Build で実績のある 6.3。ローカルの Apple Container
# (arm64 ネイティブ仮想化) では swift:6.3 が protoc-tool のリンク直後に
# セグフォルトする不具合を確認しているため (Doc/AppleContainer.md 参照)、
# ローカルでは 6.2 を使う: --build-arg SWIFT_VERSION=6.2
# (Server/Tools/run-in-container.sh はこれを自動で渡す)
#
# ビルド (リポジトリルートから):
#   container build -t tiledflipper-server -f Server/Containerfile Server
#
# 実行 (コンテナは自分の IP を持つので `container inspect` で確認して繋ぐ。
# Apple Container のボリュームマウントはディレクトリ単位で、単一ファイルは
# 直接マウントできないので、Server/ ごとマウントして --catalog で指す):
#   container run -d --name tiledflipper-server \
#     -v "$(pwd)/Server:/data:ro" \
#     tiledflipper-server \
#     --host 0.0.0.0 --port 8080 --catalog /data/ArtworkPackages.local.json
#
# まとめて行うなら Server/Scripts/run-in-container.sh を使う。

ARG SWIFT_VERSION=6.3

FROM swift:${SWIFT_VERSION} AS builder

WORKDIR /app
COPY Package.swift Package.resolved ./
COPY Sources/ Sources/

RUN swift build -c release --product TiledFlipperServer
RUN cp "$(swift build -c release --show-bin-path)/TiledFlipperServer" /usr/bin/TiledFlipperServer

FROM swift:${SWIFT_VERSION}-slim

COPY --from=builder /usr/bin/TiledFlipperServer /usr/bin/TiledFlipperServer

# ArtworkPackages.local.json はカレントディレクトリから読むので、
# 実行時のワークディレクトリをここに揃えておく。
WORKDIR /app

# Cloud Run 等、実行時にローカルファイルをマウントできない環境向けに
# ビルド時点でイメージへ焼き込む (中身は配布 URL と版数だけで機微情報は無い)。
# Apple Container でローカル実行するときは `container run --catalog` で
# 別のファイルを指せば、こちらは無視されそちらが優先される。
# このファイルが無いとビルドが失敗するので、無ければ
# `cp ArtworkPackages.example.json ArtworkPackages.local.json` で作ること。
COPY ArtworkPackages.local.json ./

EXPOSE 8080
ENTRYPOINT ["/usr/bin/TiledFlipperServer"]
# コンテナの外 (Mac ホストや実機) から繋がるように 0.0.0.0 で待ち受ける。
# `container run` 側で追加の引数を渡すとこの既定値を上書きできる。
CMD ["--host", "0.0.0.0", "--port", "8080"]
